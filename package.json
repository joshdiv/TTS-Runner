{
  "name": "tts-runner",
  "version": "1.30.0",
  "private": true,
  "description": "Feed a recording script line-by-line into a text-to-speech engine and save each clip named by its dialogue ID.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "vite build && electron . --built"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
