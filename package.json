{
  "name": "tts-runner",
  "version": "1.30.0",
  "private": true,
  "description": "Feed a recording script line-by-line into a text-to-speech engine and save each clip named by its dialogue ID.",
  "author": "joshdiv",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "vite build && electron . --built",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.joshdiv.ttsrunner",
    "productName": "TTS Runner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "backend/tts_server.exe",
        "to": "backend/tts_server.exe"
      },
      {
        "from": "resources/bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
